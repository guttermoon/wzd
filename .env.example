# Notion API credentials
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_database_id_here

# Optional: separate database for home.* copy rows; defaults to
# NOTION_DATABASE_ID (dgc-pages) when unset — see CLAUDE.md
NOTION_CONTENT_DATABASE_ID=

# Optional: Used for manual cache revalidation endpoint
REVALIDATION_SECRET=your_secret_key_here

# Absolute site origin for canonical URLs, sitemap, robots, and JSON-LD
NEXT_PUBLIC_SITE_URL=
