# ── Notion ────────────────────────────────────────────────────────────
# Create an internal integration at https://www.notion.so/my-integrations,
# then share the wzd-pages database with it (Share → Invite → your
# integration). Without these the site still renders every page using the
# built-in copy in content/site-copy.json.
NOTION_TOKEN=
NOTION_DATABASE_ID=3c16f6ccb2c180e087a4da55703d5792

# ── Site ──────────────────────────────────────────────────────────────
# Absolute origin, used for canonical URLs, the sitemap, robots.txt and
# the Event structured data. Falls back to the Vercel deployment URL.
NEXT_PUBLIC_SITE_URL=https://worldzombieday.co.uk

# Optional: required before POST /api/revalidate will do anything. Without
# it the endpoint refuses all requests.
REVALIDATION_SECRET=

# ── Analytics ─────────────────────────────────────────────────────────
# PostHog only, and it stores nothing on the visitor's device, which is why
# the site carries no cookie banner. Off unless the key is set, so nothing
# is collected locally or on an unconfigured preview. If you turn it on,
# check that /privacy still describes what you are actually collecting —
# and do not add a tool that writes to the device without adding a consent
# gate first. The project key is the phc_… value; it is public by design
# and does not need marking Sensitive.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
