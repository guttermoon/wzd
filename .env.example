# ── Notion ────────────────────────────────────────────────────────────
# Create an internal integration at https://www.notion.so/my-integrations,
# then share the wzd-pages database with it (Share → Invite → your
# integration). Without these the site still renders every page using the
# built-in copy in content/site-copy.json.
NOTION_TOKEN=
NOTION_DATABASE_ID=3c16f6ccb2c180e087a4da55703d5792

# ── Site ──────────────────────────────────────────────────────────────
# Absolute origin, used for canonical URLs, the sitemap, robots.txt, Open
# Graph and the Event structured data. Falls back to the Vercel deployment
# URL. Read at BUILD time, so it has to be set before the deploy, not
# after it. No trailing slash — one is stripped if it is there anyway,
# because everything downstream adds its own.
NEXT_PUBLIC_SITE_URL=https://worldzombieday.co.uk

# Optional: required before POST /api/revalidate will do anything. Without
# it the endpoint refuses all requests.
REVALIDATION_SECRET=

# ── Analytics ─────────────────────────────────────────────────────────
# Neither loads until the visitor accepts the cookie bar, and neither loads
# without its key, so nothing is collected locally or on an unconfigured
# preview. If you change what is collected, change /privacy to match. The
# PostHog project key is the phc_… value; it is public by design and does
# not need marking Sensitive in Vercel.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# GA4 does not need this. The measurement ID is not a secret and is built
# in (components/analytics.tsx), applied only on worldzombieday.co.uk, so a
# preview or a laptop measures nothing. Set this only to point a preview at
# a different property on purpose; it wins where it is set.
NEXT_PUBLIC_GA_ID=

# ── Brevo: the newsletter and photograph submissions ──────────────────
# One key serves both routes. Without it neither can send: /api/newsletter
# and /api/photo-submissions each answer 503 "unconfigured" and their forms
# offer the visitor a mailto: instead, so nothing is silently lost — but
# nobody is added to the list and no submission reaches an inbox.
# Create it at https://app.brevo.com → SMTP & API → API keys.
BREVO_API_KEY=

# The newsletter list. Defaults to 7, "WZDNewsletter" — the walk's own.
# Not 2, "DGCNewsletter", which is The Dead Good Club's; the two are easy
# to confuse and should not be mixed.
BREVO_LIST_ID=7

# The double opt-in confirmation email. Must be a template containing
# Brevo's {{ doubleoptin }} link or there is nothing for the reader to
# click. Defaults to 14, the walk's own copy, which sends from
# megan@worldzombieday.co.uk as World Zombie Day: London. Not 1, which is
# Brevo's default and goes out under the club's name.
BREVO_DOI_TEMPLATE_ID=14

# Where clicking the confirmation link lands them. /confirmed is the page
# built for it: it thanks them and says, in as many words, that signing up
# to the newsletter is not registering for the walk. BREVO_DOI_REDIRECT_URL
# is accepted as an alias, because the value is a URL and that is the name
# people reach for; this one wins if both are set. https, not http. It is a
# plain URL rather than a credential, so on Vercel it is a Config variable,
# not a Secret.
BREVO_DOI_REDIRECT=https://worldzombieday.co.uk/confirmed

# Overrides the contacts endpoint. Only needed if Brevo moves it.
# BREVO_CONTACTS_URL=https://api.brevo.com/v3/contacts/doubleOptinConfirmation

# ── Photograph submissions ────────────────────────────────────────────
# Where /submit-photos sends to, and sends *from*. Both default to
# EVENT.photoSubmissions in lib/event.ts — Megan, because she is the one
# who credits them. Brevo will only send from a sender it has verified,
# and hers is the verified one, which is why from and to are the same.
# PHOTO_SUBMISSIONS_TO=
# PHOTO_SUBMISSIONS_FROM=
# PHOTO_SUBMISSIONS_URL=https://api.brevo.com/v3/smtp/email

# ── Only used by the check scripts, never at runtime ──────────────────
# BASE_URL      where check:links and check:css point (default localhost:3000)
# CHROMIUM_PATH a browser for check:a11y, if Playwright's own isn't found

# ── Google Search Console ─────────────────────────────────────────────
# The token from the `<meta name="google-site-verification" content="…">`
# snippet — the content value alone, not the whole tag. Unset, no tag is
# rendered. Prefer Search Console's DNS TXT method where the domain's DNS
# is available: it verifies the domain rather than one deployment.
GOOGLE_SITE_VERIFICATION=
